---
import { Download } from "@lucide/astro";
import ThemeSelector from "./ThemeSelector.astro";
---

<header class="fixed inset-x-0 top-0 z-40 md:hidden">
	<div class="flex items-center justify-between gap-2 px-3 pt-3">
		<button
			id="menu-toggle"
			aria-label="Abrir menú de navegación"
			aria-expanded="false"
			aria-controls="mobile-nav-menu"
			class="flex h-11 w-11 items-center justify-center rounded-[14px] border border-slate-300/60 bg-gray-100/80 text-slate-800 shadow-sm backdrop-blur-xl transition-all duration-200 active:scale-90 active:opacity-70 dark:border-white/20 dark:bg-black/50 dark:text-slate-100"
		>
			<svg
				id="icon-burger"
				xmlns="http://www.w3.org/2000/svg"
				width="18"
				height="18"
				viewBox="0 0 24 24"
				fill="none"
				stroke="currentColor"
				stroke-width="2"
				stroke-linecap="round"
				stroke-linejoin="round"
				aria-hidden="true"
			>
				<line x1="4" y1="7" x2="20" y2="7"></line>
				<line x1="4" y1="12" x2="20" y2="12"></line>
				<line x1="4" y1="17" x2="20" y2="17"></line>
			</svg>
			<svg
				id="icon-x"
				xmlns="http://www.w3.org/2000/svg"
				width="18"
				height="18"
				viewBox="0 0 24 24"
				fill="none"
				stroke="currentColor"
				stroke-width="2.5"
				stroke-linecap="round"
				stroke-linejoin="round"
				aria-hidden="true"
				class="hidden"
			>
				<line x1="18" y1="6" x2="6" y2="18"></line>
				<line x1="6" y1="6" x2="18" y2="18"></line>
			</svg>
		</button>

		<div
			class="flex h-11 items-center gap-1 rounded-[14px] border border-slate-300/60 bg-gray-100/80 px-2 shadow-sm backdrop-blur-xl dark:border-white/20 dark:bg-black/50"
		>
			<ThemeSelector />
			<div class="mx-1 h-5 w-px bg-slate-300/80 dark:bg-gray-100/20"></div>
			<a
				download
				href="/docs/curriculum_vitae.pdf"
				target="_blank"
				aria-label="Descargar curriculum vitae en PDF"
				class="flex h-8 w-8 items-center justify-center rounded-xl text-slate-700 transition-colors hover:text-sky-600 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sky-500 dark:text-slate-200 dark:hover:text-sky-400"
			>
				<Download class="h-[17px] w-[17px]" />
			</a>
		</div>
	</div>
</header>

<div
	id="mobile-nav-menu"
	role="dialog"
	aria-modal="true"
	aria-label="Menú de navegación"
	class="pointer-events-none fixed left-3 right-3 top-[4.25rem] z-40 origin-top-left -translate-y-2 scale-[0.97] overflow-hidden rounded-2xl border border-white/30 bg-gray-100/60 opacity-0 shadow-xl shadow-black/10 backdrop-blur-2xl backdrop-saturate-150 transition-all duration-300 ease-out md:hidden dark:border-white/15 dark:bg-slate-900/70 dark:shadow-black/40"
>
	<nav>
		<ul
			class="flex flex-col divide-y divide-slate-900/10 py-1 dark:divide-white/10"
		>
			<li>
				<a href="/#inicio" class="nav-mobile-item">
					<span>Inicio</span>
				</a>
			</li>
			<li>
				<a href="/#proyectos" class="nav-mobile-item">
					<span>Proyectos</span>
				</a>
			</li>
			<li>
				<a href="/#sobreMi" class="nav-mobile-item">
					<span>Sobre mí</span>
				</a>
			</li>
			<li>
				<a href="#contacto" class="nav-mobile-item">
					<span>Contacto</span>
				</a>
			</li>
		</ul>
	</nav>
</div>

<div
	id="menu-backdrop"
	class="pointer-events-none fixed inset-0 z-30 bg-black/20 opacity-0 transition-opacity duration-300 md:hidden dark:bg-black/40"
>
</div>

<header
	class="fixed inset-x-0 top-0 z-40 hidden justify-center px-3 py-5 md:flex"
>
	<nav
		class="glass w-fit rounded-2xl border-2 border-slate-500 bg-sky-200/45 px-3 py-1 transition-all dark:border-white/20 dark:bg-black/10 dark:hover:border-white/30 sm:mx-auto sm:inline-flex sm:w-auto sm:px-4"
	>
		<div
			class="flex w-fit items-center justify-center gap-4 sm:w-auto sm:flex-row sm:gap-x-6 lg:gap-x-8"
		>
			<ul class="flex items-center gap-x-4 md:gap-x-6">
				<li>
					<a href="/#inicio" class="nav-link-desktop">Inicio</a>
				</li>
				<li>
					<a href="/#proyectos" class="nav-link-desktop">Proyectos</a>
				</li>
				<li>
					<a href="/#sobreMi" class="nav-link-desktop">Sobre mi</a>
				</li>
				<li>
					<a href="#contacto" class="nav-link-desktop">Contacto</a>
				</li>
			</ul>

			<div class="flex items-center gap-2 sm:gap-4">
				<ThemeSelector />
				<div class="group relative flex items-center justify-center">
					<a
						download
						href="/docs/curriculum_vitae.pdf"
						target="_blank"
						aria-label="Descargar curriculum vitae en PDF"
						class="flex h-11 w-11 items-center justify-center rounded-full text-slate-900 transition-all hover:scale-110 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sky-500 dark:text-slate-50"
					>
						<Download class="h-4 w-4 sm:h-6 sm:w-6" />
					</a>
					<span
						role="tooltip"
						class="pointer-events-none absolute bottom-full left-1/2 z-20 mb-2 -translate-x-1/2 whitespace-nowrap rounded-md border bg-slate-900 px-2.5 py-1 text-xs font-medium text-slate-50 opacity-0 shadow-sm transition-opacity invisible group-hover:visible group-hover:opacity-100 dark:border-gray-200 dark:bg-gray-100 dark:text-gray-900"
					>
						Descargar CV en PDF
					</span>
				</div>
			</div>
		</div>
	</nav>
</header>

<script>
	function setupMobileMenu() {
		const toggle = document.getElementById("menu-toggle");
		const menu = document.getElementById("mobile-nav-menu");
		const backdrop = document.getElementById("menu-backdrop");
		const iconBurger = document.getElementById("icon-burger");
		const iconX = document.getElementById("icon-x");

		if (!toggle || !menu || !backdrop) return;
		if (toggle.dataset.bound === "true") return;
		toggle.dataset.bound = "true";

		let isOpen = false;

		function openMenu() {
			isOpen = true;
			menu.classList.remove(
				"opacity-0",
				"-translate-y-2",
				"scale-[0.97]",
				"pointer-events-none",
			);
			menu.classList.add("opacity-100", "translate-y-0", "scale-100");
			backdrop.classList.remove("opacity-0", "pointer-events-none");
			backdrop.classList.add("opacity-100", "pointer-events-auto");
			iconBurger?.classList.add("hidden");
			iconX?.classList.remove("hidden");
			toggle.setAttribute("aria-expanded", "true");
		}

		function closeMenu() {
			isOpen = false;
			menu.classList.add(
				"opacity-0",
				"-translate-y-2",
				"scale-[0.97]",
				"pointer-events-none",
			);
			menu.classList.remove("opacity-100", "translate-y-0", "scale-100");
			backdrop.classList.add("opacity-0", "pointer-events-none");
			backdrop.classList.remove("opacity-100", "pointer-events-auto");
			iconBurger?.classList.remove("hidden");
			iconX?.classList.add("hidden");
			toggle.setAttribute("aria-expanded", "false");
		}

		toggle.addEventListener("click", () => (isOpen ? closeMenu() : openMenu()));
		backdrop.addEventListener("click", closeMenu);
		menu
			.querySelectorAll("a")
			.forEach((link) => link.addEventListener("click", closeMenu));
		document.addEventListener("keydown", (e) => {
			if (e.key === "Escape" && isOpen) closeMenu();
		});
	}

	if (document.readyState !== "loading") {
		setupMobileMenu();
	} else {
		document.addEventListener("DOMContentLoaded", setupMobileMenu);
	}
</script>

<style>
	.glass {
		backdrop-filter: blur(10px);
		position: relative;
	}

	.nav-link-desktop {
		@apply cursor-pointer text-sm text-slate-900 transition-all hover:text-sky-600 dark:text-slate-50 dark:hover:text-sky-400 md:text-base;
	}

	.nav-mobile-item {
		@apply flex min-h-[54px] select-none items-center justify-between px-5 py-[15px] text-base font-semibold text-slate-900 transition-colors duration-150 hover:bg-black/5 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-sky-500 active:bg-black/10 dark:text-white dark:hover:bg-gray-100/10 dark:active:bg-gray-100/15;
	}
</style>
