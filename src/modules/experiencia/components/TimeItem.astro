---
const {
	title,
	date,
	description,
	place,
	url,
	img,
	imgDark,
	order = 0,
	datetime,
	isFirst = false,
} = Astro.props;

const escapeHtml = (text: string) =>
	text
		.replace(/&/g, "&amp;")
		.replace(/</g, "&lt;")
		.replace(/>/g, "&gt;")
		.replace(/"/g, "&quot;")
		.replace(/'/g, "&#39;");

const renderHighlight = (text: string) =>
	escapeHtml(text).replace(
		/\*\*(.+?)\*\*/g,
		'<strong class="font-semibold text-slate-900 dark:text-slate-100">$1</strong>',
	);
---

<li
	class="mx-2 md:mx-12 w-full pb-10 md:pb-12 flex flex-col gap-4 md:flex-row md:gap-8 before:absolute before:left-[-35px] before:hidden before:h-full before:border-l-2 before:border-slate-200 md:before:block dark:before:border-white/15 before:content-['']"
	data-reveal-item
	style={`--motion-delay: ${120 + order * 90}ms; --motion-duration: var(--motion-duration-base); --motion-distance: 16px; --motion-blur: 4px;`}
>
	<span
		class="absolute -left-[42px] top-1.5 z-10 flex size-[14px] items-center justify-center rounded-full bg-gray-50 dark:bg-slate-950 md:bg-transparent md:dark:bg-transparent"
		aria-hidden="true"
	>
		{
			isFirst && (
				<span class="motion-safe:animate-ping absolute inline-flex size-full rounded-full bg-sky-400/50" />
			)
		}
		<span
			class:list={[
				"relative inline-flex size-[10px] rounded-full bg-sky-500 dark:bg-sky-300",
				isFirst && "shadow-[0_0_8px_2px_rgba(56,189,248,0.45)]",
			]}></span>
	</span>

	<div
		class="md:grid md:grid-cols-[220px_1fr] flex flex-col gap-4 md:grid-rows-[auto_1fr] md:gap-x-8"
	>
		<h3
			class="md:row-start-1 md:col-start-1 text-xl sm:text-2xl font-bold text-sky-500 dark:text-sky-300 leading-tight whitespace-nowrap"
		>
			{title}
		</h3>

		<div class="md:row-start-2 md:col-start-1 flex flex-col gap-2">
			<div class="flex gap-2.5 justify-start items-center">
				<img
					src={img}
					width="36"
					height="36"
					loading="lazy"
					decoding="async"
					class:list={[
						"object-cover p-1 border bg-gray-100 border-slate-50/45 rounded-xl h-9 w-9 shadow-md shadow-black/10 dark:bg-gray-800 dark:border-gray-700 dark:shadow-black/40 shrink-0",
						imgDark && "dark:hidden",
					]}
					alt={`${title} ${place} Logo`}
				/>
				{
					imgDark && (
						<img
							src={imgDark}
							width="36"
							height="36"
							loading="lazy"
							decoding="async"
							class="hidden dark:block object-contain p-1 border bg-gray-800 border-gray-700 rounded-xl h-9 w-9 shadow-md shadow-black/40 shrink-0"
							alt={`${title} ${place} Logo`}
						/>
					)
				}
				<a
					href={url}
					target="_blank"
					rel="noopener noreferrer"
					aria-label={`Visitar sitio de ${place} (se abre en nueva pestaña)`}
					class="rounded-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sky-500 focus-visible:ring-offset-1"
				>
					<p
						class="text-lg sm:text-xl font-bold text-slate-900 dark:text-slate-100 hover:underline hover:text-sky-600 dark:hover:text-sky-400"
					>
						{place}
					</p>
				</a>
			</div>
			<time
				class="text-sm font-medium text-slate-500 dark:text-slate-400"
				datetime={datetime ?? date}>{date}</time
			>
		</div>

		<div
			class="md:row-start-2 md:col-start-2 md:self-center flex flex-col gap-2.5"
		>
			<p class="text-xs sm:text-sm font-medium text-slate-500 dark:text-slate-400">
				Trabajando en {place} logré:
			</p>
			<ol class="pl-4 flex flex-col gap-2.5">
				{
					description.map((item: string) => (
						<li
							class="text-base leading-relaxed text-slate-700 dark:text-slate-300 list-disc"
							set:html={renderHighlight(item)}
						/>
					))
				}
			</ol>
		</div>
	</div>
</li>
