---
const {
	title,
	date,
	description,
	place,
	url,
	img,
	imgDark,
	order = 0,
	datetime,
	isFirst = false,
} = Astro.props;

const escapeHtml = (text: string) =>
	text
		.replace(/&/g, "&amp;")
		.replace(/</g, "&lt;")
		.replace(/>/g, "&gt;")
		.replace(/"/g, "&quot;")
		.replace(/'/g, "&#39;");

const renderHighlight = (text: string) =>
	escapeHtml(text).replace(
		/\*\*(.+?)\*\*/g,
		'<strong class="font-semibold text-slate-900 dark:text-slate-100">$1</strong>',
	);
---

<li
	class="mx-2 md:mx-12 w-full pb-10 md:pb-12 flex flex-col gap-4 md:flex-row md:gap-8 before:absolute before:left-[-35px] before:hidden before:h-full before:border-l-2 before:border-slate-200 md:before:block dark:before:border-white/15 before:content-['']"
	data-reveal-item
	style={`--motion-delay: ${120 + order * 90}ms; --motion-duration: var(--motion-duration-base); --motion-distance: 16px; --motion-blur: 4px;`}
>
	<span
		class="absolute -left-[42px] top-1.5 z-10 flex size-[14px] items-center justify-center rounded-full bg-gray-50 dark:bg-slate-950 md:bg-transparent md:dark:bg-transparent"
		aria-hidden="true"
	>
		{
			isFirst && (
				<span class="motion-safe:animate-ping absolute inline-flex size-full rounded-full bg-sky-400/50" />
			)
		}
		<span
			class:list={[
				"relative inline-flex size-[10px] rounded-full bg-sky-500 dark:bg-sky-300",
				isFirst && "shadow-[0_0_8px_2px_rgba(56,189,248,0.45)]",
			]}></span>
	</span>

	<div class="flex w-full flex-col gap-5">
		<header
			class="grid gap-3 md:grid-cols-[minmax(0,1fr)_auto] md:items-start md:gap-6"
		>
			<div class="flex min-w-0 items-center gap-4">
				<img
					src={img}
					width="44"
					height="44"
					loading="lazy"
					decoding="async"
					class:list={[
						"h-11 w-11 shrink-0 rounded-xl border border-slate-300/80 bg-white object-contain p-1.5 shadow-sm shadow-black/10 dark:border-white/15 dark:bg-gray-800 dark:shadow-black/40",
						imgDark && "dark:hidden",
					]}
					alt={`${place} Logo`}
				/>
				{
					imgDark && (
						<img
							src={imgDark}
							width="44"
							height="44"
							loading="lazy"
							decoding="async"
							class="hidden h-11 w-11 shrink-0 rounded-xl border border-white/15 bg-gray-800 object-contain p-1.5 shadow-sm shadow-black/40 dark:block"
							alt={`${place} Logo`}
						/>
					)
				}

				<div class="flex min-w-0 flex-col gap-1">
					<h3
						class="text-xl font-bold leading-tight text-slate-900 dark:text-slate-100 sm:text-2xl"
					>
						{title}
					</h3>
					<p class="text-sm font-medium text-slate-500 dark:text-slate-400">
						en
						<a
							href={url}
							target="_blank"
							rel="noopener noreferrer"
							aria-label={`Visitar sitio de ${place} (se abre en nueva pestaña)`}
							class="rounded-sm font-semibold text-slate-700 transition-colors hover:text-sky-600 hover:underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sky-500 focus-visible:ring-offset-1 dark:text-slate-300 dark:hover:text-sky-300"
						>
							{place}
						</a>
					</p>
				</div>
			</div>

			<time
				class="text-sm font-medium text-slate-500 dark:text-slate-400 md:justify-self-end md:pt-1"
				datetime={datetime ?? date}>{date}</time
			>
		</header>

		<div class="flex w-full max-w-3xl flex-col gap-2.5">
			<p
				class="text-xs sm:text-sm font-medium text-slate-500 dark:text-slate-400"
			>
				Durante este período logré:
			</p>
			<ol class="pl-4 flex flex-col gap-2.5">
				{
					description.map((item: string) => (
						<li
							class="text-base leading-relaxed text-slate-700 dark:text-slate-300 list-disc"
							set:html={renderHighlight(item)}
						/>
					))
				}
			</ol>
		</div>
	</div>
</li>
