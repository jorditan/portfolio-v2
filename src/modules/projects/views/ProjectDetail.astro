---
import { existsSync } from "node:fs";
import { Image } from "astro:assets";
import { ArrowLeft, ArrowUpRight, Check } from "@lucide/astro";
import InfoPill from "@/common/components/astroComponentes/InfoPill.astro";
import ProjectTags from "../components/ProjectTags.astro";
import ProjectDetailCarousel from "../components/ProjectDetailCarousel.jsx";
import { projectImages, projectGalleries } from "@/lib/images";
import { getCategoryLabel } from "../../../lib/projects.js";

interface Props {
	project: any;
	prev?: any;
	next?: any;
}

const { project } = Astro.props;

const detail = project.detail ?? {};
const heroImage = projectImages[project.slug];
const categoryLabel = getCategoryLabel(project.category);
const impactItems: string[] = Array.isArray(detail.impact) ? detail.impact : [];
const galleryImages = projectGalleries[project.slug] ?? [];
const gifSrc =
	project.hasGif && project.gifImage && existsSync(`public${project.gifImage}`)
		? project.gifImage
		: null;

const slides = [
	...(heroImage
		? [{ src: heroImage.src, alt: `${project.title} - Imagen principal` }]
		: []),
	...galleryImages.map((img, i) => ({
		src: img.src,
		alt: `${project.title} - Captura ${i + 1}`,
	})),
	...(gifSrc ? [{ src: gifSrc, alt: `${project.title} - Demo` }] : []),
];

const motion = (delay: number) =>
	`--motion-delay: ${delay}ms; --motion-duration: var(--motion-duration-base); --motion-distance: 18px;`;
---

<article class="mx-auto max-w-6xl px-4 pb-20 pt-24 md:pt-32">
	{/* Header con Breadcrumbs */}
	<header class="md:mb-8 mb-4">
		<nav
			aria-label="Migas de pan"
			class="mb-3 flex flex-wrap items-center gap-2 text-sm text-slate-500 dark:text-slate-400"
			data-reveal-item
			style={motion(0)}
		>
			<a
				href="/"
				class="transition-colors hover:text-sky-600 dark:hover:text-sky-400"
			>
				Inicio
			</a>
			<span class="text-slate-300 dark:text-slate-700" aria-hidden="true"
				>/</span
			>
			<a
				href="/#proyectos"
				class="transition-colors hover:text-sky-600 dark:hover:text-sky-400"
			>
				Proyectos
			</a>
			<span class="text-slate-300 dark:text-slate-700" aria-hidden="true"
				>/</span
			>
			<span class="font-medium text-slate-900 dark:text-slate-100">
				{project.title}
			</span>
		</nav>

		<div class="flex gap-2 md:gap-4 items-center">
			<a
				href="/#proyectos"
				class="inline-flex h-10 w-10 items-center justify-center rounded-lg border border-slate-300/80 bg-gray-100 text-slate-700 transition hover:bg-slate-200 hover:text-sky-600 dark:border-white/15 dark:bg-slate-900 dark:text-slate-200 dark:hover:bg-slate-800 dark:hover:text-sky-400"
			>
				<ArrowLeft
					class="text-slate-900 transition-colors dark:text-slate-50"
					aria-hidden="true"
				/>
			</a>
			<h1
				class="text-2xl font-bold tracking-tight text-slate-900 sm:text-4xl md:text-5xl dark:text-slate-50"
				data-reveal-item
				style={motion(100)}
			>
				{project.title}
			</h1>
		</div>
	</header>

	{/* Carousel con las capturas de cada proyecto */}
	{
		slides.length > 0 && (
			<section class="md:mb-12 mb-4" data-reveal-item style={motion(160)}>
				<ProjectDetailCarousel
					client:load
					images={slides}
					title={project.title}
				/>
			</section>
		)
	}

	{/* Grilla Principal de 2 Columnas */}
	<div
		class="grid grid-cols-1 gap-10 md:grid-cols-[1fr_300px] lg:grid-cols-[1fr_340px] lg:gap-14 items-start"
	>
		{/* Columna Izquierda: Narrativa del Proyecto */}
		<div class="flex flex-col gap-10">
			{
				project.shortDescription && (
					<section data-reveal-item style={motion(200)}>
						<p class="ui-text-lead mt-3 text-gray-700 dark:text-gray-300">
							{project.shortDescription}
						</p>
					</section>
				)
			}

			{
				detail.problem && (
					<section data-reveal-item style={motion(240)}>
						<h2 class="text-xl font-bold text-slate-900 dark:text-slate-50">
							El problema
						</h2>
						<p class="ui-text-body mt-3 leading-relaxed text-gray-700 dark:text-gray-300">
							{detail.problem}
						</p>
					</section>
				)
			}

			{
				detail.process && (
					<section data-reveal-item style={motion(280)}>
						<h2 class="text-xl font-bold text-slate-900 dark:text-slate-50">
							El proceso
						</h2>
						<p class="ui-text-body mt-3 leading-relaxed text-gray-700 dark:text-gray-300">
							{detail.process}
						</p>
					</section>
				)
			}

			{
				detail.outcome && (
					<section data-reveal-item style={motion(320)}>
						<h2 class="text-xl font-bold text-slate-900 dark:text-slate-50">
							El resultado
						</h2>
						<p class="ui-text-body mt-3 leading-relaxed text-gray-700 dark:text-gray-300">
							{detail.outcome}
						</p>
					</section>
				)
			}

			{
				impactItems.length > 0 && (
					<section data-reveal-item style={motion(360)}>
						<h2 class="text-xl font-bold text-slate-900 dark:text-slate-50">
							Impacto y logros
						</h2>
						<ul class="mt-3 flex flex-col gap-2.5">
							{impactItems.map((item) => (
								<li class="flex items-start gap-2.5">
									<Check
										class="mt-1 h-4 w-4 shrink-0 text-sky-500 dark:text-sky-400"
										aria-hidden="true"
									/>
									<span class="ui-text-body text-gray-700 dark:text-gray-300">
										{item}
									</span>
								</li>
							))}
						</ul>
					</section>
				)
			}
		</div>

		{/* Columna Derecha*/}
		<aside
			class="md:top-28 md:border-l md:border-gray-500 md:pl-8 lg:pl-10 md:dark:border-slate-600"
		>
			<div class="flex flex-col gap-6" data-reveal-item style={motion(220)}>
				{
					(project.role || categoryLabel) && (
						<div class="flex flex-col gap-2">
							<h3 class="text-base font-semibold text-slate-900 dark:text-slate-100">
								Categoría/s
							</h3>
							<div class="flex flex-wrap gap-2">
								{categoryLabel && <InfoPill text={categoryLabel} />}
								{project.role && <InfoPill text={project.role} />}
							</div>
						</div>
					)
				}

				{
					project.year && (
						<div class="flex flex-col gap-1.5 border-t border-gray-500 pt-5 dark:border-slate-600">
							<h3 class="text-base font-semibold text-slate-900 dark:text-slate-100">
								Período
							</h3>
							<p class="ui-text-body font-medium text-slate-700 dark:text-slate-300">
								{project.year}
							</p>
						</div>
					)
				}

				{
					project.tags?.length > 0 && (
						<div class="flex flex-col gap-2.5 border-t border-gray-500 pt-5 dark:border-slate-600">
							<h3 class="text-base font-semibold text-slate-900 dark:text-slate-100">
								Herramientas y tecnologías
							</h3>
							<ProjectTags tags={project.tags} />
						</div>
					)
				}

				{
					project.link && (
						<div class="border-t border-gray-500 pt-5 dark:border-slate-600">
							<a
								href={project.link}
								target="_blank"
								rel="noopener noreferrer"
								class="group inline-flex w-full items-center justify-center gap-2.5 rounded-lg border border-slate-600 bg-slate-900 px-4 py-2.5 text-base font-semibold text-white shadow-md shadow-slate-900/10 transition-all duration-200 hover:bg-slate-800 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sky-500 focus-visible:ring-offset-2 dark:border-slate-600 dark:bg-slate-900 dark:text-slate-50 dark:shadow-black/30 dark:hover:bg-slate-800 dark:focus-visible:ring-offset-slate-950"
							>
								<span>{project.linkLabel ?? "Visitar proyecto"}</span>
								<ArrowUpRight
									class="h-4 w-4 shrink-0 transition-transform duration-200 group-hover:-translate-y-0.5 group-hover:translate-x-0.5"
									aria-hidden="true"
								/>
							</a>
						</div>
					)
				}
			</div>
		</aside>
	</div>
</article>
