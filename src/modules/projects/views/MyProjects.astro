---
import { Palette } from "@lucide/astro";
import { getImage } from "astro:assets";
import FeaturedCard from "../components/FeaturedCard.astro";
import ProjectCard from "../components/ProjectCard.astro";
import ProjectCarousel from "../components/ProjectCarousel.jsx";
import { getProjectsSorted, getCategoryLabel } from "../../../lib/projects.js";
import { projectImages } from "@/lib/images";

async function withOptimizedImages(list: ReturnType<typeof getProjectsSorted>) {
	return Promise.all(
		list.map(async (project) => {
			const meta = projectImages[project.slug];
			if (!meta) {
				return { ...project, heroImage: project.heroImage };
			}
			const optimized = await getImage({
				src: meta,
				width: 800,
				height: 450,
				format: "webp",
				quality: 75,
			});
			return { ...project, heroImage: optimized.src, imageMeta: meta };
		}),
	);
}

const allProjects = (await withOptimizedImages(getProjectsSorted())).map(
	(project) => ({
		...project,
		href: `/proyectos/${project.slug}`,
		categoryLabel: getCategoryLabel(project.category),
	}),
);

const featuredProjects = allProjects.filter((p) => p.featured && p.imageMeta);
const secondaryProjects = allProjects.filter((p) => !p.featured && p.imageMeta);
---

<section
	class="mx-4 max-w-[32rem] py-8 transition-all sm:mx-auto md:max-w-[42rem] lg:max-w-4xl"
	id="proyectos"
	aria-label="Mis proyectos"
>
	<div
		class="mb-6 flex items-center justify-start gap-2"
		data-reveal-item
		style="--motion-delay: 0ms; --motion-duration: var(--motion-duration-fast); --motion-distance: 12px;"
	>
		<Palette class="h-8 w-8 text-sky-500 dark:text-sky-300" />
		<h2
			class="title w-fit text-xl font-semibold text-slate-900 md:text-2xl dark:text-slate-50"
		>
			Proyectos
		</h2>
	</div>

	<ProjectCarousel
		client:visible
		projects={allProjects}
		compact
		baseMotionDelay={120}
	/>

	{
		featuredProjects.length > 0 && (
			<div
				class:list={[
					"mt-6 hidden gap-4 sm:grid",
					featuredProjects.length > 1 ? "sm:grid-cols-2" : "",
				]}
			>
				{featuredProjects.map((project, idx) => (
					<FeaturedCard
						title={project.title}
						shortDescription={project.shortDescription}
						href={project.href}
						image={project.imageMeta}
						role={project.role}
						categoryLabel={project.categoryLabel}
						tags={project.tags}
						motionDelay={120 + idx * 80}
					/>
				))}
			</div>
		)
	}

	{
		secondaryProjects.length > 0 && (
			<div class="mt-4 hidden w-full gap-4 sm:grid sm:grid-cols-2 lg:grid-cols-3">
				{secondaryProjects.map((project, idx) => (
					<ProjectCard
						title={project.title}
						shortDescription={project.shortDescription}
						href={project.href}
						image={project.imageMeta}
						categoryLabel={project.categoryLabel}
						compact
						motionDelay={200 + idx * 80}
					/>
				))}
			</div>
		)
	}
</section>
