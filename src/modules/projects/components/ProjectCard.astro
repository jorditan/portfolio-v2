---
import { Image } from "astro:assets";
import { ArrowUpRight } from "@lucide/astro";
import type { ImageMetadata } from "astro";

interface Props {
	title: string;
	shortDescription: string;
	href: string;
	image: ImageMetadata;
	year?: string;
	categoryLabel?: string;
	compact?: boolean;
	motionDelay?: number;
}

const {
	title,
	shortDescription,
	href,
	image,
	year,
	categoryLabel,
	compact = false,
	motionDelay = 220,
} = Astro.props;

const metaText = categoryLabel;
---

<a
	href={href}
	aria-label={`Ver proyecto: ${title}`}
	class="group flex h-full w-full cursor-pointer flex-col overflow-hidden rounded-xl border-2 border-gray-200 bg-gray-100 shadow-md shadow-slate-300/60 transition-[transform,box-shadow,border-color] duration-300 hover:scale-[1.02] hover:rotate-1 hover:border-sky-300 hover:shadow-lg hover:shadow-slate-300/70 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sky-500 focus-visible:ring-offset-2 dark:border-gray-600 dark:bg-gray-800 dark:shadow-black/30 dark:hover:border-gray-300 dark:hover:shadow-black/40"
	data-reveal-item
	style={`--motion-delay: ${motionDelay}ms; --motion-duration: var(--motion-duration-base); --motion-distance: 18px;`}
>
	<div class="overflow-hidden">
		<Image
			src={image}
			alt={`${title} - ${shortDescription}`}
			widths={[400, 600, 800]}
			sizes="(max-width: 640px) 90vw, (max-width: 1024px) 40vw, 360px"
			width={600}
			height={compact ? 338 : 450}
			loading="lazy"
			decoding="async"
			format="webp"
			quality={75}
			class:list={[
				"w-full object-cover object-top transition-transform duration-500 group-hover:scale-[1.03]",
				compact ? "aspect-video" : "aspect-[4/3]",
			]}
		/>
	</div>

	<div class:list={["flex flex-1 flex-col gap-2", compact ? "p-3" : "p-4"]}>
		<div class="flex items-center justify-between gap-1">
			<h3
				class="text-base font-semibold leading-tight text-slate-900 transition-colors group-hover:text-sky-600 dark:text-slate-50 dark:group-hover:text-sky-300"
			>
				{title}
			</h3>
			<span
				class="mt-1 flex items-center justify-center rounded-md border border-gray-700 px-1 py-1 text-sm text-gray-400 transition-colors group-hover:text-sky-500 dark:bg-gray-900 dark:text-gray-200 dark:group-hover:text-sky-300"
				aria-hidden="true"
			>
				<ArrowUpRight class="h-4 w-4" />
			</span>
		</div>

		<p
			class="line-clamp-2 text-base leading-relaxed text-gray-600 dark:text-gray-400"
		>
			{shortDescription}
		</p>

		{
			metaText && (
				<p class="ui-text-caption mt-auto pt-1 text-slate-500 dark:text-slate-400">
					{metaText}
				</p>
			)
		}
	</div>
</a>
