---
import { Image } from "astro:assets";
import { ArrowUpRight } from "@lucide/astro";
import type { ImageMetadata } from "astro";
import InfoPill from "@/common/components/astroComponentes/InfoPill.astro";
import ProjectTags from "./ProjectTags.astro";

interface Tag {
	iconType?: string;
	text: string;
}

interface Props {
	title: string;
	shortDescription: string;
	href: string;
	image: ImageMetadata;
	year?: string;
	role?: string;
	categoryLabel?: string;
	tags?: Tag[];
	motionDelay?: number;
}

const {
	title,
	shortDescription,
	href,
	image,
	year,
	role,
	categoryLabel,
	tags = [],
	motionDelay = 140,
} = Astro.props;

const metaText = role;
---

<a
	href={href}
	aria-label={`Ver proyecto: ${title}`}
	class="group flex h-full cursor-pointer flex-col overflow-hidden rounded-xl border-2 border-gray-200 bg-gray-100 shadow-lg shadow-slate-300/70 transition-[transform,box-shadow,border-color] duration-300 hover:scale-[1.02] hover:border-sky-300 hover:shadow-xl hover:shadow-slate-300/80 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sky-500 focus-visible:ring-offset-2 dark:border-gray-600 dark:bg-gray-800 dark:shadow-black/40 dark:hover:border-gray-300 dark:hover:shadow-black/50"
	data-reveal-item
	style={`--motion-delay: ${motionDelay}ms; --motion-duration: var(--motion-duration-base); --motion-distance: 18px;`}
>
	<div class="overflow-hidden">
		<Image
			src={image}
			alt={`${title} - ${shortDescription}`}
			widths={[640, 800, 1200]}
			sizes="(max-width: 768px) 90vw, (max-width: 1024px) 42rem, 56rem"
			width={800}
			height={450}
			loading="lazy"
			decoding="async"
			format="webp"
			quality={75}
			class="aspect-video w-full object-cover object-top transition-transform duration-500 group-hover:scale-[1.03]"
		/>
	</div>

	<div class="flex flex-1 flex-col gap-3 p-5">
		<div class="flex items-center justify-between gap-2">
			<h3
				class="text-xl font-semibold leading-tight text-slate-900 transition-colors group-hover:text-sky-600 md:text-2xl dark:text-slate-50 dark:group-hover:text-sky-300"
			>
				{title}
			</h3>
			<span
				class="mt-1 flex items-center justify-center rounded-md border border-gray-700 px-1 py-1 text-sm text-gray-400 transition-colors group-hover:text-sky-500 dark:bg-gray-900 dark:text-gray-200 dark:group-hover:text-sky-300"
				aria-hidden="true"
			>
				<ArrowUpRight class="h-4 w-4" />
			</span>
		</div>

		{
			(categoryLabel || metaText) && (
				<div class="flex flex-wrap items-center gap-2">
					{categoryLabel && <InfoPill text={categoryLabel} />}
					{metaText && (
						<span class="ui-text-caption text-slate-500 dark:text-slate-400">
							{metaText}
						</span>
					)}
				</div>
			)
		}

		<p class="ui-text-body leading-relaxed text-gray-700 dark:text-gray-300">
			{shortDescription}
		</p>

		{
			tags.length > 0 && (
				<div class="mt-auto pt-1">
					<ProjectTags tags={tags} />
				</div>
			)
		}
	</div>
</a>
