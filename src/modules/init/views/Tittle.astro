---
import { Image } from "astro:assets";
import SocialIconLink from "@/common/components/astroComponentes/SocialIconLink.astro";
import { miscImages } from "@/lib/images";
import { siteConfig } from "@/lib/config";

const socialLinks = [
	{ label: "LinkedIn", href: siteConfig.social.linkedin, icon: "linkedin" },
	{ label: "GitHub", href: siteConfig.social.github, icon: "github" },
	{ label: "Behance", href: siteConfig.social.behance, icon: "behance" },
];

// Cambiar a `true` cuando esté disponible para nuevos proyectos
const isAvailable = false;
const statusBorderClass = isAvailable
	? "border-emerald-400/80 group-hover:border-emerald-500 dark:border-emerald-400/50 dark:group-hover:border-emerald-400"
	: "border-sky-400/80 group-hover:border-sky-500 dark:border-sky-400/50 dark:group-hover:border-sky-400";
const statusDotClass = isAvailable ? "bg-emerald-500" : "bg-sky-500";
---

<section
	class="sm:mx-auto pt-20 sm:pt-28 py-16 lg:py-22 mx-4 max-w-[32rem] md:max-w-[42rem] lg:max-w-4xl"
	id="inicio"
	data-motion-hero
>
	<article class="flex flex-col gap-6" aria-label="Bienvenida al portfolio">
		<div class="hero-layout flex min-w-0 flex-1 flex-col gap-4 md:gap-8">
			<div
				class="hero-heading flex flex-col gap-4 md:gap-4"
				data-motion="hero-item"
				style="--motion-delay: 60ms; --motion-duration: var(--motion-duration-fast); --motion-distance: 12px;"
			>
				<div
					class="hero-heading-row z-0 flex items-left md:flex-row md:items-end md:gap-4"
				>
					<div class="hero-title-row flex items-center gap-4">
						<figure
							class="hero-avatar group relative shrink-0 self-center sm:self-auto"
							data-motion="hero-item"
							style="--motion-delay: 220ms; --motion-duration: var(--motion-duration-slow); --motion-distance: 20px; --motion-blur: var(--motion-blur-md);"
							aria-label="Foto de perfil de Matías Jordán, actualmente trabajando en Hackmetrix"
						>
							<Image
								src={miscImages.fotoLinkedin}
								alt="Matías Owen Jordán"
								width={160}
								height={160}
								widths={[64, 96, 160, 320]}
								sizes="(min-width: 1024px) 160px, (min-width: 640px) 96px, 64px"
								loading="eager"
								fetchpriority="high"
								decoding="async"
								format="webp"
								quality={75}
								class={`h-16 w-16 rounded-md border-2 bg-gray-100 object-cover p-1 shadow-md shadow-black/10 transition-colors dark:bg-gray-800 dark:shadow-black/40 sm:h-24 sm:w-24 lg:h-40 lg:w-40 lg:rounded-xl ${statusBorderClass}`}
							/>
							<span
								class={`absolute -bottom-0.5 -right-0.5 z-10 h-3 w-3 rounded-full border-2 border-white shadow-sm dark:border-gray-950 sm:h-3.5 sm:w-3.5 lg:h-4 lg:w-4 ${statusDotClass}`}
								aria-hidden="true"></span>

							<span
								role="tooltip"
								class="absolute bottom-full left-0 mb-2 z-10 max-w-[calc(100vw-3rem)] px-3 py-2 text-sm font-medium text-slate-50 dark:text-gray-900 bg-slate-900 dark:bg-gray-100 border dark:border-gray-200 rounded-lg shadow-sm whitespace-nowrap opacity-0 invisible group-hover:visible group-focus-within:visible group-hover:opacity-100 group-focus-within:opacity-100 transition-opacity pointer-events-none"
							>
								Actualmente trabajando en Hackmetrix
							</span>
						</figure>
						<div
							class="hero-title"
							data-motion="hero-static-word"
							style="--motion-delay: 120ms;"
						>
							<h1
								class="title ui-text-hero flex flex-row flex-wrap gap-2 font-bold w-fit text-[#0f172a] dark:text-[#fafafa]"
							>
								Matías
								<span class="selected-word">
									<span class="selected-bg"></span>
									<span class="selected-text">Jordán</span>
								</span>
							</h1>
						</div>
					</div>
				</div>
				<p
					class="hero-description w-fit text-[20px] text-[#141a28] dark:text-gray-200 lg:max-w-xl"
					data-motion="hero-item"
					style="--motion-delay: 280ms; --motion-duration: var(--motion-duration-base); --motion-distance: 18px; --motion-blur: var(--motion-blur-sm);"
				>
					<b class="dark:text-sky-300 text-sky-500">+2 años de experiencia</b> diseñando
					y desarrollando productos digitales. Especializado en sistemas complejos
					<b class="dark:text-sky-300 text-sky-500"
						>con foco en negocio y métricas de adopción y retención</b
					>.
				</p>

				<div
					class="hero-actions flex flex-wrap gap-3"
					data-motion="hero-item"
					style="--motion-delay: 360ms; --motion-duration: var(--motion-duration-base); --motion-distance: 16px;"
				>
					{
						socialLinks.map((link) => (
							<SocialIconLink
								href={link.href}
								label={link.label}
								icon={link.icon}
							/>
						))
					}
				</div>
			</div>
		</div>
	</article>

	<style scoped>
		.puestos {
			overflow: hidden;
		}

		.roles,
		h2 {
			list-style: none;
		}
		.roles {
			position: relative;
			height: 36px;
			animation: slide 5s cubic-bezier(0.2, -0.2, 0.1, 1) infinite;
		}

		h2 {
			position: absolute;
		}
		h2:first-child {
			top: 100%;
		}

		h2:last-child {
			top: 300%;
		}

		@keyframes slide {
			0% {
				transform: translateY(0);
			}
			15%,
			30% {
				transform: translateY(-100%);
			}
			45%,
			60% {
				transform: translateY(-300%);
			}
			100% {
				transform: translateY(-100%);
			}
		}

		.icon {
			@apply text-slate-50;
		}

		.badge {
			backdrop-filter: blur(5px);
		}
		.selected-word {
			position: relative;
			display: inline-block;
		}

		.selected-bg {
			position: absolute;
			inset: 80% 0 5% 0;
			background: oklch(68.5% 0.169 237.323);
			transform: scaleX(0);
			transform-origin: left;
			animation: selectWord 700ms ease-out 300ms forwards;
			border-radius: 8px;
		}

		.selected-text {
			position: relative;
			z-index: 1;
		}

		@media (min-width: 1024px) {
			.hero-layout {
				display: grid;
				grid-template-columns: 10rem minmax(0, 1fr);
				column-gap: 2.5rem;
				row-gap: 1.5rem;
				align-items: center;
			}

			.hero-heading,
			.hero-heading-row,
			.hero-title-row {
				display: contents;
			}

			.hero-avatar {
				grid-column: 1;
				grid-row: 1 / span 2;
			}

			.hero-title {
				grid-column: 2;
				grid-row: 1;
				align-self: end;
				min-width: 0;
			}

			.hero-description {
				grid-column: 2;
				grid-row: 2;
				align-self: start;
			}

			.hero-actions {
				grid-column: 1 / -1;
				grid-row: 3;
				justify-self: start;
			}
		}
		@media (prefers-reduced-motion: reduce) {
			.roles {
				animation: none;
				height: auto;
				display: flex;
				flex-direction: column;
				gap: 0.25rem;
			}

			h2 {
				position: static;
			}

			.selected-bg {
				transform: scaleX(1);
				animation: none;
			}

			.badge {
				animation: none;
			}
		}

		@keyframes selectWord {
			to {
				transform: scaleX(1);
			}
		}
	</style>
</section>
