---
import { Image } from "astro:assets";
import { Code, PenTool } from "@lucide/astro";
import type { ImageMetadata } from "astro";

interface Props {
	title: string;
	image: ImageMetadata;
	url: string;
	type: string;
}

const { title, image, url, type } = Astro.props;
---

<article
	class="group m-2 flex h-full flex-col overflow-hidden rounded-md border border-slate-200 bg-gray-100 shadow-md shadow-slate-300/60 backdrop-blur-sm transition-[transform,box-shadow,border-color] duration-300 hover:-translate-y-1 hover:border-sky-400/70 hover:shadow-lg hover:shadow-slate-300/70 dark:border-white/10 dark:bg-gray-800 dark:shadow-black/30 dark:hover:border-slate-50 dark:hover:shadow-black/40"
>
	<a
		href={url}
		target="_blank"
		rel="noopener noreferrer"
		aria-label={`${title} (se abre en nueva pestaña)`}
	>
		<div
			class="aspect-[16/9] overflow-hidden border-b border-slate-200/80 bg-slate-100 dark:border-white/10 dark:bg-slate-900/70"
		>
			<Image
				src={image}
				alt={title}
				widths={[360, 480, 720]}
				sizes="(max-width: 640px) 90vw, (max-width: 1280px) 45vw, 360px"
				width={400}
				height={225}
				loading="lazy"
				decoding="async"
				format="webp"
				quality={70}
				class="h-full w-full object-cover object-center transition-transform duration-500 group-hover:scale-[1.03]"
			/>
		</div>

		<div class="flex h-unset flex-1 flex-col gap-2 p-3">
			<div class="flex h-unset flex-col gap-2">
				<h3 class="ui-text-card-title truncate text-slate-900 dark:text-slate-100">
					{title}
				</h3>

				{
					type === "design" ? (
						<span class="ui-text-caption flex w-fit items-center gap-2 rounded-md border border-sky-500 bg-sky-100 p-1 text-sky-500 dark:bg-sky-800 dark:text-sky-200">
							<PenTool class="h-3 w-3" />
							Diseño
						</span>
					) : (
						<span class="ui-text-caption flex w-fit items-center gap-2 rounded-md border border-green-500 bg-green-100 p-1 text-green-500 dark:bg-green-800 dark:text-green-300">
							<Code class="h-3 w-3" />
							Desarrollo
						</span>
					)
				}
			</div>
		</div>
	</a>
</article>
