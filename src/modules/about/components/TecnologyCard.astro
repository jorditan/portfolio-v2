---
const { tooltip } = Astro.props;

const seed = [...tooltip].reduce((acc, char) => acc + char.charCodeAt(0), 0);
const duration = 3 + (seed % 5) * 0.4;
const delay = (seed % 7) * 0.45;
---

<div class="group relative flex justify-center items-center">
	<div
		class="tech-card w-[4rem] animate animate-pulse flex-col transition-transform duration-500 ease-[cubic-bezier(0.22,1,0.36,1)] hover:scale-[1.18] flex justify-center items-center h-[4rem] rounded-lg hover:will-change-transform bg-gray-100/80
	       dark:bg-white/5
	       border border-slate-300/40 dark:border-white/15
	       backdrop-blur-md
	       shadow-sm shadow-black/5 dark:shadow-black/25"
		style={`--tech-card-duration:${duration}s; --tech-card-delay:-${delay}s;`}
	>
		<slot name="icon" />
	</div>

	<span
		role="tooltip"
		class="absolute bottom-full left-1/2 -translate-x-1/2 mb-2 z-20 px-2.5 py-1 text-xs font-medium text-slate-50 dark:text-gray-900 bg-slate-900 dark:bg-gray-100 border dark:border-gray-200 rounded-md shadow-sm opacity-0 invisible group-hover:visible group-hover:opacity-100 transition-opacity pointer-events-none whitespace-nowrap"
	>
		{tooltip}
	</span>
</div>

<style>
	.tech-card {
		animation: tech-card-breathe var(--tech-card-duration)
			cubic-bezier(0.45, 0.05, 0.55, 0.95) var(--tech-card-delay) infinite;
	}

	.tech-card:hover {
		animation-play-state: paused;
	}

	@keyframes tech-card-breathe {
		0%,
		100% {
			transform: scale(1);
		}

		50% {
			transform: scale(1.18);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.tech-card {
			animation: none;
		}
	}
</style>
