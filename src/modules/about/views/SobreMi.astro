---
import { Cake, HandHeart, Heart, MapPin } from "@lucide/astro";
import { getImage } from "astro:assets";
import MyCarousel from "../components/MyCarousel";
import Tecnologias from "./Tecnologias.astro";
import Certificados from "./Certificados.astro";
import Reviews from "./Reviews.astro";
import SectionHeader from "@/common/components/astroComponentes/SectionHeader.astro";
import InfoPill from "@/common/components/astroComponentes/InfoPill.astro";
import { aboutPhotos, certificates } from "@/lib/images";

const familiaPhotos = await Promise.all(
	aboutPhotos.familia.map(async (photo) => {
		const optimized = await getImage({
			src: photo.src,
			width: 512,
			height: 512,
			format: "webp",
			quality: 70,
		});
		return { src: optimized.src, alt: photo.alt };
	}),
);

const personalPhotos = await Promise.all(
	aboutPhotos.personal.map(async (photo) => {
		const optimized = await getImage({
			src: photo.src,
			width: 512,
			height: 512,
			format: "webp",
			quality: 70,
		});
		return { src: optimized.src, alt: photo.alt };
	}),
);
---

<section
	class="mx-4 max-w-[32rem] py-8 transition-all sm:mx-auto sm:py-10 md:max-w-[42rem] lg:max-w-4xl"
	id="sobreMi"
>
	<article class="mb-6 flex w-full flex-col items-left gap-6">
		<div class="flex w-full flex-col items-start gap-2">
			<div
				data-reveal-item
				style="--motion-delay: 0ms; --motion-duration: var(--motion-duration-fast); --motion-distance: 12px;"
			>
				<SectionHeader title="Quién soy">
					<HandHeart
						slot="icon"
						class="h-8 w-8 text-sky-500 dark:text-sky-300"
					/>
				</SectionHeader>
			</div>
			<div
				class="flex w-full flex-wrap gap-2"
				data-reveal-item
				style="--motion-delay: 70ms; --motion-duration: var(--motion-duration-fast); --motion-distance: 12px;"
			>
				<InfoPill text="Haedo. Buenos Aires, Argentina">
					<MapPin slot="icon" class="h-4 w-4" />
				</InfoPill>
				<InfoPill text="21 años">
					<Cake slot="icon" class="h-4 w-4" />
				</InfoPill>
				<InfoPill text="Hincha de Boca Juniors" variant="boca">
					<Heart slot="icon" fill="currentColor" class="h-4 w-4" />
				</InfoPill>
			</div>
		</div>

		<div>
			<div
				class="flex flex-col items-center justify-between gap-4 lg:flex-row lg:gap-8"
			>
				<div
					class="flex w-full flex-col gap-6 lg:w-3/4"
					data-reveal-item
					style="--motion-delay: 140ms; --motion-duration: var(--motion-duration-base); --motion-distance: 18px;"
				>
					<p
						class="ui-text-body w-fit font-medium text-gray-600 antialiased dark:text-gray-300"
					>
						Desde chico soy una persona inquieta y curiosa.
						<span class="font-semibold text-gray-800 dark:text-[#ffffff]"
							>Crecí en una familia que siempre me motivó a aprender cosas
							nuevas</span
						>.
					</p>

					<p
						class="ui-text-body w-fit font-medium text-gray-600 antialiased dark:text-gray-300"
					>
						Mi mamá es profesora de matemática y mi hermano de música , mientras
						que mi papá fue un apasionado de la historia. <span
							class="font-semibold text-gray-800 dark:text-[#ffffff]"
							>Gracias a ellos, tuve acceso a charlas que alimentaron mi
							creatividad</span
						>.
					</p>

					<p
						class="ui-text-body w-fit font-medium text-gray-600 antialiased dark:text-gray-300"
					>
						Fuí criado con la idea de <span
							class="font-semibold text-gray-800 dark:text-[#ffffff]"
							>compartir conocimientos y ayudar a los demás</span
						>, lo que me llevó a desarrollar una <span
							class="font-semibold text-gray-800 dark:text-[#ffffff]"
							>gran empatía y una mirada colaborativa
						</span> que con el tiempo se convirtieron en pilares fundamentales de
						mi vida y de mi carrera
					</p>
				</div>

				<div
					class="flex flex-col items-center justify-center gap-4"
					data-reveal-item
					style="--motion-delay: 220ms; --motion-duration: var(--motion-duration-base); --motion-distance: 18px;"
				>
					<MyCarousel
						id="carousel-familia"
						photos={familiaPhotos}
						client:visible
					/>
				</div>
			</div>
		</div>

		<h3 class="ui-text-section-subtitle text-gray-800 dark:text-[#ffffff]">
			Y bien, ¿cómo me convertí en diseñador?
		</h3>

		<div class="grid grid-cols-1 items-start gap-4 md:grid-cols-[auto_1fr]">
			<div
				class="flex w-full flex-col gap-6 md:col-start-2 md:row-start-1"
				data-reveal-item
				style="--motion-delay: 140ms; --motion-duration: var(--motion-duration-base); --motion-distance: 18px;"
			>
				<p
					class="ui-text-body w-fit font-medium text-gray-600 antialiased dark:text-gray-300"
				>
					A mis 15 años <span
						class="font-semibold text-gray-800 dark:text-[#ffffff]"
						>comenzó a interesame el diseño web gracias a la pandemia y a la
						viralización de la profesión</span
					>. Entonces, con tiempo de sobra, aproveché y realicé mis primeras
					páginas con HTML y CSS.
				</p>

				<p
					class="ui-text-body w-fit font-medium text-gray-600 antialiased dark:text-gray-300"
				>
					Pasé el 2020-2021 haciendo cursos y tutoriales por mi cuenta, hasta
					que terminada la secundaria decidí dar un paso más: <span
						class="font-semibold text-gray-800 dark:text-[#ffffff]"
						>anotarme a la tecnicatura en programación en la</span
					>
					<a
						href="https://unahur.edu.ar/"
						target="_blank"
						class="text-sky-800 underline decoration-sky-500 dark:text-sky-300"
					>
						UNAHUR</a
					>.
				</p>

				<p
					class="ui-text-body w-fit font-medium text-gray-600 antialiased dark:text-gray-300"
				>
					Al mismo tiempo, profundicé mis estudios de diseño UX/UI y<span
						class="font-semibold text-gray-800 dark:text-[#ffffff]"
					>
						descubrí que una solución no basta con ser linda visual y
						técnicamente, si no que también debe resolver problemas del usuario
					</span>.
				</p>
			</div>

			<div
				class="flex items-center justify-center md:col-start-1 md:row-span-2 md:row-start-1"
				data-reveal-item
				style="--motion-delay: 220ms; --motion-duration: var(--motion-duration-base); --motion-distance: 18px;"
			>
				<MyCarousel
					id="carousel-personal"
					photos={personalPhotos}
					client:visible
				/>
			</div>
		</div>
	</article>

	<Tecnologias />
	<Certificados certificados={certificates} />
	<Reviews />
</section>
